  "extensions": [],
  "packages": [
    "./extensions/ui-kit",
    "./extensions/subagents",
    "./extensions/md-log",
    "./extensions/prompt-snippets",
    "./extensions/apply-patch",
    "./extensions/web",
    "./extensions/caffeine",
    "./extensions/codex-utils",
