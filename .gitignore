# Only version Pi configuration and hand-maintained resources.
# New top-level state stays private until explicitly allowlisted here.
/*
!/.gitignore
!/.gitmodules
!/README.md
!/AGENTS.md
!/THIRD_PARTY_NOTICES.md
!/settings.json
!/settings.example.json
!/subagents.json
!/keybindings.json
!/models.example.json
!/extensions/
!/skills/
!/subagents/
!/themes/
!/prompts/
!/tests/

# Pi's git package checkout is also a submodule; keep the cache root private.
!/git/
/git/*
!/git/.gitignore
!/git/github.com/
/git/github.com/*
!/git/github.com/park-csu/
/git/github.com/park-csu/*
!/git/github.com/park-csu/pi-observational-memory/

# Keep ticket templates, never live tickets or task notes.
!/tickets/
/tickets/*
!/tickets/_template/

# Dependencies, caches, generated state, and local test artifacts anywhere
# inside the allowlisted resource directories.
**/.git/
**/node_modules/
**/.memory/
**/.cache/
**/.turbo/
**/.venv/
**/__pycache__/
**/.pytest_cache/
**/dist/
**/build/
**/coverage/
**/target/
**/tmp/
**/temp/
**/out/
**/viz/
**/sessions/
**/subagent-runs/
**/reports/
**/*.tsbuildinfo
**/*.log
**/*.log.*
**/*.jsonl
**/*.sqlite
**/*.sqlite3
**/*.sqlite-*
**/*.db
**/*.db-*

# Credentials and machine-specific trust are never publishable.
**/auth.json
**/trust.json
**/models.json
**/models-store.json
**/credentials.json
**/secrets.json
**/.secrets/
**/.env
**/.env.*
!**/.env.example
**/.envrc
**/.npmrc
**/.netrc
**/.pypirc
**/.ssh/
**/.aws/
**/.terraform/
**/*.tfstate
**/*.tfstate.*
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/id_rsa*
**/id_ed25519*

# Editors and stray output from local subagent checks.
**/.DS_Store
**/Thumbs.db
**/.idea/
**/.vscode/
**/*.swp
**/*~
/extensions/subagents/e
/extensions/subagents/o
