{
  "name": "apply-patch",
  "version": "1.0.0",
  "description": "Sequential V4A apply_patch tool for pi",
  "type": "module",
  "keywords": [
    "pi-package",
    "apply-patch"
  ],
  "license": "MIT",
  "files": [
    "index.ts",
    "src",
    "test",
    "README.md",
    "tsconfig.json"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "scripts": {
    "test": "node test/run-tests.mjs",
    "test:codex": "CODEX_DIFFERENTIAL=1 node test/run-tests.mjs && node --test test/eol-compat.test.mjs",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*",
    "ui-kit": "*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.7.0",
    "ui-kit": "file:../ui-kit"
  }
}
